{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regocr.local/schemas/merged_company.schema.json",
  "title": "Merged Commercial Registry + Company Enrichment Document (v0.3)",
  "description": "Combined output contract merging RegOCR extraction (stage 1) with external company-info enrichment (stage 2).",
  "type": "object",
  "required": [
    "schema_version",
    "company_id",
    "document_id",
    "pipeline_status",
    "updated_at",
    "external_keys",
    "ocr",
    "enrichment",
    "merged"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "company_id": {
      "type": "string",
      "format": "uuid",
      "description": "Internal stable UUID generated by the website backend. Never derived from register_number because register numbers may only be unique per issuing office."
    },
    "document_id": {
      "type": "string",
      "minLength": 8,
      "description": "Stable content-addressed or UUID document identifier matching RegOCR ExtractionResult.document_id."
    },
    "pipeline_status": {
      "type": "string",
      "enum": ["pending", "ocr_done", "needs_review", "enriched", "failed"],
      "description": "End-to-end orchestration state across OCR, human review, and company enrichment."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unified_register_number": { "type": ["string", "null"] },
        "national_entity_number": { "type": ["string", "null"] },
        "register_number": { "type": ["string", "null"] },
        "issuing_office": { "type": ["string", "null"] },
        "tax_id": { "type": ["string", "null"] }
      }
    },
    "ocr": {
      "type": "object",
      "required": ["schema_version", "submission_id", "document_id", "status", "fields"],
      "properties": {
        "schema_version": { "type": "string" },
        "submission_id": { "type": "string" },
        "document_id": { "type": "string" },
        "status": { "enum": ["accepted", "needs_review", "rejected"] },
        "fields": { "type": "object" }
      }
    },
    "enrichment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "description": "Provider identifier (e.g., licensed_b2b_api, teammate_linkedin_stage)." },
        "status": { "enum": ["matched", "ambiguous", "not_found", "failed", "skipped"] },
        "fetched_at": { "type": ["string", "null"], "format": "date-time" },
        "match_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "matched_url": { "type": ["string", "null"] },
        "company_name_en": { "type": ["string", "null"] },
        "company_name_ar": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "headquarters": { "type": ["string", "null"] },
        "employee_count_range": { "type": ["string", "null"] },
        "founded_year": { "type": ["integer", "null"] },
        "description": { "type": ["string", "null"] },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "match_score"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "location": { "type": ["string", "null"] },
              "industry": { "type": ["string", "null"] },
              "match_score": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "merged": {
      "type": "object",
      "required": ["fields", "conflicts", "needs_review"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/merged_field" }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "ocr_value", "enrichment_value", "resolution", "reason"],
            "properties": {
              "field": { "type": "string" },
              "ocr_value": {},
              "enrichment_value": {},
              "resolution": { "enum": ["prefer_ocr", "prefer_enrichment", "human_review"] },
              "reason": { "type": "string" }
            }
          }
        },
        "needs_review": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "merged_field": {
      "type": "object",
      "required": ["value", "provenance", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "provenance": { "enum": ["ocr", "enrichment", "human_override"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "verified_by_human": { "type": "boolean", "default": false }
      }
    }
  }
}
