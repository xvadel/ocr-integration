{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regocr.local/schemas/registration_schema.json",
  "title": "RegOCR Commercial Register Extraction Output (v0.4)",
  "description": "Strict output contract for RegOCR (Stage 1) aligned with src/regocr/models.py ExtractionResult.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "submission_id",
    "created_at",
    "status",
    "document",
    "extraction",
    "fields",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["0.3", "0.4"] },
    "schema_id": { "type": ["string", "null"] },
    "schema_status": { "type": ["string", "null"] },
    "package_status": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "document_type": { "type": ["string", "null"] },
    "template_id": { "type": ["string", "null"] },
    "documents": { "type": ["array", "null"] },
    "handoff": { "type": ["object", "null"] },
    "document_id": { "type": "string", "minLength": 8 },
    "submission_id": { "type": "string", "minLength": 4 },
    "created_at": { "type": "string", "format": "date-time" },
    "test_data": { "type": "boolean" },
    "status": { "enum": ["accepted", "needs_review", "rejected"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "reupload_hint": { "type": ["string", "null"] },
    "document": {
      "type": "object",
      "required": ["type", "file_format", "pages", "page_used", "pages_processed", "quality"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["commercial_register", "tax_card", "unknown"] },
        "file_format": { "enum": ["image", "pdf"] },
        "pdf_kind": { "enum": ["digital", "scanned", "digital_garbled", "mixed", null] },
        "pages": { "type": "integer", "minimum": 1 },
        "page_used": { "type": "integer", "minimum": 1 },
        "pages_processed": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "quality": {
          "type": "object",
          "required": ["score", "issues"],
          "additionalProperties": false,
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "issues": {
              "type": "array",
              "items": { "enum": ["blurry", "low_resolution", "skewed", "dark", "cropped", "noisy", "uneven_illumination"] }
            }
          }
        }
      }
    },
    "preprocessing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "steps_applied", "skew_angle", "blur_score", "illumination_score", "perspective_corrected", "quality_flags"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "steps_applied": { "type": "array", "items": { "type": "string" } },
          "skew_angle": { "type": "number" },
          "blur_score": { "type": "number" },
          "illumination_score": { "type": "number" },
          "perspective_corrected": { "type": "boolean" },
          "orientation_angle": { "type": "integer" },
          "stamp_suppressed": { "type": "boolean" },
          "quality_flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "extraction": {
      "type": "object",
      "required": ["text_method", "languages", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "text_method": { "enum": ["text_layer", "ocr", "mixed", "vision_llm", "none"] },
        "engine": { "type": ["string", "null"] },
        "languages": { "type": "array", "items": { "type": "string" } },
        "ocr_confidence_mean": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "fields": {
      "type": "object",
      "required": ["company_name", "register_number", "issue_date"],
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "raw_text": { "type": ["string", "null"] },
    "review": {
      "type": "object",
      "required": ["required", "fields_to_review"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "fields_to_review": { "type": "array", "items": { "type": "string" } },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["value", "engine", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "raw": { "type": ["string", "null"] },
        "engine": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "page": { "type": "integer", "minimum": 1 },
        "variant": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "required": ["value", "status", "needs_review", "grounded", "candidates"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "null"] },
        "raw": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "engines_agree": { "type": ["boolean", "null"] },
        "validated": { "type": ["boolean", "null"] },
        "needs_review": { "type": "boolean" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "status": { "enum": ["ok", "suspect", "missing", "unreadable", "invalid"] },
        "grounded": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "code": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "calendar": { "type": ["string", "null"] }
      }
    }
  }
}
